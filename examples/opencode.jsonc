// Global (~/.config/opencode/opencode.jsonc) or project-local (<project>/opencode.jsonc) example.
// Install from npm ("opencode-lazy-se@latest") or use a local path ("./plugins/lazy-skills").
{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    [
      "opencode-lazy-se@latest",
      {
        "mode": "auto",
        "autoBind": "adaptive",
        "coexistence": "respect",
        "respectHostPermissions": true,
        "nativeCatalog": "preserve",
        "hints": "off",
        "vaultAutoBind": false
      }
    ]
  ]
}
