{
  "name": "opencode-lazy-se",
  "version": "1.5.0",
  "description": "Host-neutral, multilingual, cooperative lazy skill discovery and binding for OpenCode V2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./dist/tui.d.ts"
    },
    "./rpc": {
      "import": "./dist/stats-rpc.js",
      "types": "./dist/stats-rpc.d.ts"
    }
  },
  "files": [
    "dist",
    "docs",
    "index.js",
    "tui.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-lazy-se",
    "opencode-lazy-skill-engine",
    "skills",
    "lazy-loading",
    "multilingual",
    "bm25",
    "tui",
    "ai-agent"
  ],
  "author": "Hüseyin Hadi Çığ",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huseyincig/opencode-lazy-skill-engine.git"
  },
  "bugs": {
    "url": "https://github.com/huseyincig/opencode-lazy-skill-engine/issues"
  },
  "homepage": "https://github.com/huseyincig/opencode-lazy-skill-engine#readme",
  "peerDependencies": {
    "@opencode/plugin": ">=2 <3",
    "@opentui/core": ">=0.8.4",
    "@opentui/solid": ">=0.8.4",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.27.1",
    "@opencode/plugin": "^2.3.0",
    "@opentui/core": "^0.9.2",
    "@opentui/solid": "^0.9.2",
    "@types/node": "^22.0.0",
    "babel-preset-solid": "^1.9.17",
    "solid-js": "^1.9.17",
    "typescript": "^5.8.0"
  },
  "scripts": {
    "build": "node -e \"import('node:fs').then(f=>f.rmSync('dist',{recursive:true,force:true}))\" && tsc",
    "postbuild": "node scripts/emit-tui.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit --noUnusedLocals --noUnusedParameters --noUncheckedIndexedAccess --exactOptionalPropertyTypes",
    "test": "npm run build && node --test",
    "check": "node scripts/check.mjs",
    "benchmark": "npm run build && node tests/benchmark.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  }
}
